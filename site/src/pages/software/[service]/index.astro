---
import Base from '../../../layouts/Base.astro';
import { getProductNames } from '@lib/matrix.js';
import { dimTypeNames, getDimensions, getLines, PRODUCT_LABELS } from '@lib/compat.js';
import { lineHubHref } from '@lib/hub.js';
import { getPair } from '@lib/pair.js';

export function getStaticPaths() {
  return getDimensions().map((d) => ({ params: { service: d.key } }));
}

const { service } = Astro.params;
const dim = getDimensions().find((d) => d.key === service)!;
const types = dimTypeNames(dim);
const rows = getProductNames().flatMap((product) =>
  getLines(product).map(({ line, releases }) => ({
    product,
    label: `${PRODUCT_LABELS[product] ?? product} ${line}`,
    href: lineHubHref(product, line, dim.key) ?? `/${product}/${releases.at(-1)!.version}/`,
    pairs: dim.options.map((o) => getPair(product, line, o)!),
  })),
);
const lastRun = rows.flatMap((r) => r.pairs.map((p) => p.lastRun)).filter(Boolean).sort().at(-1) ?? null;
const tone = (p: { passing: number; tested: number }) =>
  p.tested === 0 ? 'border border-dotted border-line text-muted' : p.passing === p.tested ? 'bg-pass text-pass-ink' : p.passing === 0 ? 'bg-fail text-fail-ink border border-dashed border-fail-line' : 'border border-line text-ink bg-surface';
const title = `Magento ${types} version compatibility`;
---

<Base
  title={title}
  description={`Every Magento and Mage-OS release line against every ${types} version we test, from real installs: how many releases in each line install and pass.`}
  updated={lastRun}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Services', item: new URL('/software/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: dim.label, item: new URL(`/software/${dim.key}/`, Astro.site).href },
    ],
  }}
>
  <nav class="flex flex-wrap gap-1 text-sm font-semibold" aria-label="Kind of service">
    {getDimensions().map((d) => (
      <a
        href={`/software/${d.key}/`}
        aria-current={d.key === dim.key ? 'page' : undefined}
        class:list={['px-3 py-2 rounded-lg no-underline', d.key === dim.key ? 'bg-ink text-ground' : 'text-muted hover:text-ink']}
      >{d.label}</a>
    ))}
  </nav>

  <h1 class="mt-5 font-display font-extrabold text-4xl sm:text-5xl tracking-tight">{title}</h1>
  <p class="mt-3 text-lg text-muted max-w-3xl">
    Each cell is how many releases of that line install and pass on that version. Pick a cell for the full answer and
    the reason for every failure, or a line for every version against every release.
  </p>

  <div class="mt-8 overflow-x-auto rounded-2xl border border-line bg-surface">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-line">
          <th scope="col" class="p-3 text-left font-semibold text-muted">Line</th>
          {dim.options.map((o) => (
            <th scope="col" class="p-2 text-center font-mono font-semibold whitespace-nowrap">
              <a href={o.href} class="text-ink no-underline hover:text-brand" title={`Which Magento & Mage-OS versions support ${o.label}?`}>{o.key === 'php' ? o.version : o.short}</a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-b border-line last:border-b-0">
            <th scope="row" class="p-3 text-left font-mono font-medium whitespace-nowrap">
              <a href={r.href} class="text-ink no-underline hover:text-brand">{r.label}</a>
            </th>
            {r.pairs.map((p) => (
              <td class="p-1.5 text-center">
                <a
                  href={p.href}
                  class:list={['inline-grid place-items-center min-w-12 h-9 px-1.5 rounded-md font-mono text-xs font-semibold no-underline', tone(p)]}
                  title={`${r.label} on ${p.option.label}: ${p.tested === 0 ? 'not tested' : `${p.passing} of ${p.tested} install`}`}
                >{p.tested === 0 ? '·' : `${p.passing}/${p.tested}`}</a>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-12 font-display font-extrabold text-2xl tracking-tight">Every {types} version we test</h2>
  <ul class="mt-4 flex flex-wrap gap-2">
    {dim.options.map((o) => (
      <li><a href={o.href} class="inline-flex items-center min-h-11 px-3 rounded-lg border border-line bg-surface font-mono text-sm text-ink no-underline hover:border-brand">{o.label}</a></li>
    ))}
  </ul>
</Base>
