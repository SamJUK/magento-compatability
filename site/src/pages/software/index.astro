---
import Base from '../../layouts/Base.astro';
import { getDimensions, PRODUCT_LABELS } from '@lib/compat.js';
import { newestPerProduct } from '@lib/service.js';

const dims = getDimensions().map((d) => ({
  ...d,
  options: d.options.map((o) => ({ ...o, newest: newestPerProduct(o) })),
}));
---

<Base title="Magento compatibility by service version" description="Pick the PHP, database, search, cache, queue, web server or Varnish version your host runs and see which Magento and Mage-OS releases install on it.">
  <h1 class="font-display font-extrabold text-4xl sm:text-5xl tracking-tight">Start from your server</h1>
  <p class="mt-3 text-lg text-muted max-w-3xl">
    Pick what your host runs. Each card shows the newest release that installs on it.
  </p>

  {dims.map((d) => (
    <section class="mt-10" aria-labelledby={`dim-${d.key}`}>
      <h2 id={`dim-${d.key}`} class="font-display font-bold text-2xl">{d.label}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {d.options.map((o) => (
          <a href={o.href} class="rounded-xl border border-line bg-surface p-4 flex flex-col gap-2 no-underline text-ink hover:border-brand">
            <span class="font-mono font-semibold">{o.label}</span>
            {o.newest.map((n) => (
              <span class="text-sm text-muted">
                {PRODUCT_LABELS[n.product] ?? n.product}: <span class:list={['font-mono', n.newest ? 'text-ink' : '']}>{n.newest ?? 'none'}</span>
              </span>
            ))}
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
