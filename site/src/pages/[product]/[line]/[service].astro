---
import LineHubPage from '../../../components/LineHubPage.astro';
import QuestionPage from '../../../components/QuestionPage.astro';
import type { DimKey } from '@lib/compat.js';
import { lineHubPaths } from '@lib/hub.js';
import { pairPaths } from '@lib/pair.js';

// One route, two pages: /magento/2.4.6/opensearch-2.19/ answers one version, /magento/2.4.6/search/ lists them all.
export function getStaticPaths() {
  return [...pairPaths(), ...lineHubPaths()];
}

const { product, line, service } = Astro.params;
const { key, hub } = Astro.props as { key: DimKey; hub?: boolean };
---

{hub ? <LineHubPage product={product} line={line} dimKey={key} /> : <QuestionPage product={product} line={line} service={service} dimKey={key} />}
