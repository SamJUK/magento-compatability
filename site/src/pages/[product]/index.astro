---
import Base from '../../layouts/Base.astro';
import StatusCell from '../../components/StatusCell.astro';
import { getProductNames } from '@lib/matrix.js';
import { getCells, getDimensions, getLines, PRODUCT_LABELS, STEP_LABELS } from '@lib/compat.js';
import { neededWorkarounds } from '@lib/workarounds.js';

export function getStaticPaths() {
  return getProductNames().map((product) => ({ params: { product } }));
}

const { product } = Astro.params;
const label = PRODUCT_LABELS[product] ?? product;
const dims = getDimensions().filter((d) => ['php', 'db', 'search'].includes(d.key));
const columns = dims.flatMap((d) => d.options.map((o) => ({ ...o, dimLabel: d.label })));
const lines = getLines(product);

const rows = lines.flatMap(({ line, releases }) =>
  releases
    .slice()
    .reverse()
    .map((r, i) => {
      const cells = getCells(product, r.version);
      return {
        version: r.version,
        line,
        latest: i === 0,
        firstOfLine: i === 0,
        cells: columns.map((col) => {
          const c = cells.get(col.id)!;
          const why = c.failure ? ` (${STEP_LABELS[c.failure.step]}: ${c.failure.summary})` : '';
          const verdict = c.status === 'pass' ? 'works' : c.status === 'fail' ? 'fails' : 'not tested';
          const needed = c.status === 'pass' ? neededWorkarounds(c.result?.workarounds) : [];
          const extra = needed.length > 0;
          const needs = extra ? `, needs ${needed.map((w) => w.title).join('; ')}` : '';
          return { ...c, extra, title: `${r.version} with ${col.label}: ${verdict}${c.recommended ? ', recommended' : ''}${needs}${why}` };
        }),
      };
    }),
);

const recPassing = rows.filter((r) => r.cells.some((c) => c.recommended && c.status === 'pass'));
const recTested = rows.filter((r) => r.cells.some((c) => c.recommended && c.status !== 'untested'));
---

<Base title={`${label} matrix`} description={`Every ${label} release against every PHP, database and search version we test, with an upgrade planner.`}>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex flex-col gap-3 max-w-3xl">
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl tracking-tight">Plan a {label} upgrade</h1>
      <p class="text-muted text-lg leading-relaxed">
        Pick where you are and where you are going. The route keeps the services you tick running at every step,
        stopping at an earlier release when a straight jump would break one. Highlighted columns work on both ends.
      </p>
    </div>
    <nav class="flex gap-1 p-1 rounded-xl bg-sunken" aria-label="Product">
      {getProductNames().map((p) => (
        <a
          href={`/${p}`}
          aria-current={p === product ? 'page' : undefined}
          class:list={['px-4 py-2.5 rounded-lg font-semibold no-underline', p === product ? 'bg-ink text-ground' : 'text-muted hover:text-ink']}
        >{PRODUCT_LABELS[p] ?? p}</a>
      ))}
    </nav>
  </div>

  <section id="planner" class="mt-8 rounded-2xl bg-panel text-panel-ink p-5 sm:p-7 grid gap-6 lg:grid-cols-[360px_minmax(0,1fr)]" aria-label="Upgrade planner">
    <div class="flex flex-col gap-3">
      <label class="flex items-center gap-3 font-display text-xl font-bold">
        <span class="w-28 shrink-0">I'm on</span>
        <select id="plan-from" class="flex-1 h-12 rounded-lg bg-surface text-ink px-3 font-mono text-base cursor-pointer">
          <option value="" selected>Pick a release</option>
          {rows.map((r) => <option value={r.version}>{r.version}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-3 font-display text-xl font-bold">
        <span class="w-28 shrink-0">Going to</span>
        <select id="plan-to" class="flex-1 h-12 rounded-lg bg-surface text-ink px-3 font-mono text-base cursor-pointer">
          <option value="" selected>Pick a release</option>
          {rows.map((r) => <option value={r.version}>{r.version}</option>)}
        </select>
      </label>
      <fieldset class="mt-2 flex flex-col gap-2">
        <legend class="text-sm font-semibold">Keep the same through each upgrade</legend>
        <p class="text-xs text-panel-muted leading-relaxed">Tick what is hard to change on your hosting. Physical servers usually need the database and search engine to carry over; containers can swap anything.</p>
        <div class="flex flex-wrap gap-2">
          {dims.map((d) => (
            <label class="inline-flex items-center gap-2 h-9 px-3 rounded-lg bg-black/20 text-sm font-semibold cursor-pointer">
              <input type="checkbox" name="sticky" value={d.key} checked={d.key !== 'php'} class="size-4 accent-brand" />
              {d.label}
            </label>
          ))}
        </div>
      </fieldset>
    </div>
    <div aria-live="polite" class="flex flex-col gap-3">
      <h2 class="text-xs font-bold uppercase tracking-wider text-panel-muted">The route</h2>
      <ol id="plan-steps" class="flex flex-col gap-2.5 text-base leading-snug">
        <li class="text-panel-muted">Pick where you are and where you are going.</li>
      </ol>
    </div>
  </section>

  <section class="mt-8 rounded-2xl border border-line bg-surface">
    <div class="relative overflow-x-auto">
      <table id="matrix" class="border-separate border-spacing-0 text-sm">
        <caption class="sr-only">{label} releases against PHP, database and search versions</caption>
        <thead>
          <tr>
            <th scope="col" rowspan="2" class="sticky left-0 z-10 bg-surface text-left px-4 pt-4 pb-2 font-display text-base">Release</th>
            {dims.map((d) => (
              <th scope="colgroup" colspan={d.options.length} class="text-left px-2 pt-4 pb-1 font-display text-base border-l border-line">{d.label}</th>
            ))}
          </tr>
          <tr>
            {columns.map((c, i) => (
              <th
                scope="col"
                data-col={i}
                data-dim={c.key}
                data-label={c.label}
                class:list={['px-1 pb-2 pt-1 font-mono text-[11px] font-medium text-muted whitespace-nowrap align-bottom', i > 0 && columns[i - 1].key !== c.key && 'border-l border-line']}
                title={c.label}
              >{c.short.split(' ').map((part) => <span class="block leading-tight">{part}</span>)}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="bg-surface" data-version={r.version} data-latest={r.latest ? '1' : undefined} hidden={!r.latest} id={r.firstOfLine ? `line-${r.line}` : undefined}>
              <th scope="row" class="sticky left-0 z-10 bg-inherit text-left px-4 py-1.5 border-t border-line whitespace-nowrap">
                <a href={`/${product}/${r.version}`} class="font-mono font-medium text-ink no-underline hover:text-brand">{r.version}</a>
                <span data-tag class="ml-1.5 px-1.5 py-0.5 rounded bg-brand text-on-brand text-[10px] font-bold" hidden></span>
              </th>
              {r.cells.map((c, i) => (
                <td data-col={i} class:list={['px-0.5 py-1 text-center border-t border-line', i > 0 && columns[i - 1].key !== columns[i].key && 'border-l']}>
                  <StatusCell status={c.status} recommended={c.recommended} extra={c.extra} href={`/${product}/${r.version}`} title={c.title} class="min-w-8 h-8" />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4 border-t border-line text-sm text-muted">
      <span class="flex items-center gap-2"><StatusCell status="pass" title="Works" class="min-w-7 h-7" />Installs and passes</span>
      <span class="flex items-center gap-2"><StatusCell status="pass" extra title="Works with an extra step" class="min-w-7 h-7" />Works with an extra patch or module</span>
      <span class="flex items-center gap-2"><StatusCell status="fail" title="Fails" class="min-w-7 h-7" />Fails</span>
      <span class="flex items-center gap-2"><StatusCell status="pass" recommended title="Recommended stack" class="min-w-7 h-7" />Recommended stack</span>
      <span class="flex items-center gap-2"><StatusCell status="untested" title="Not tested" class="min-w-7 h-7" />Not tested</span>
      <button id="toggle-patches" type="button" aria-pressed="false" class="ml-auto px-3 py-2 rounded-lg border border-line text-ink font-semibold cursor-pointer hover:border-brand">
        Show every patch
      </button>
    </div>
  </section>

  <p class="mt-6 text-muted">
    Cache, queue, web server and Varnish results are on each release page.
    The recommended stack passes on {recPassing.length} of {recTested.length} tested {label} releases.{' '}
    <a href={`/${product}/baseline`}>See every recommended-stack run</a>.
  </p>
</Base>

<script>
  const table = document.getElementById('matrix') as HTMLTableElement;
  const from = document.getElementById('plan-from') as HTMLSelectElement;
  const to = document.getElementById('plan-to') as HTMLSelectElement;
  const toggle = document.getElementById('toggle-patches') as HTMLButtonElement;
  const steps = document.getElementById('plan-steps') as HTMLOListElement;
  const sticky = [...document.querySelectorAll<HTMLInputElement>('input[name="sticky"]')];
  const headers = [...table.querySelectorAll<HTMLElement>('thead th[data-col]')];
  const rows = [...table.querySelectorAll<HTMLTableRowElement>('tbody tr')]; // newest first
  const rowOf = (v: string) => rows.find((r) => r.dataset.version === v);
  const passes = (row: HTMLTableRowElement, col: number) =>
    row.querySelector<HTMLElement>(`td[data-col="${col}"] [data-status]`)!.dataset.status === 'pass';
  const colsOf = (dim: string) => headers.map((th, i) => ({ th, i })).filter(({ th }) => th.dataset.dim === dim);
  const dimLabel = (dim: string) => sticky.find((c) => c.value === dim)!.parentElement!.textContent!.trim();
  const shared = (a: HTMLTableRowElement, b: HTMLTableRowElement, dim: string) =>
    colsOf(dim).filter(({ i }) => passes(a, i) && passes(b, i));
  const recommended = (row: HTMLTableRowElement, dim: string) =>
    colsOf(dim).find(({ i }) => row.querySelector(`td[data-col="${i}"] [data-rec]`))?.th.dataset.label;
  const family = (label?: string) => label?.split(' ')[0];

  // Which shared version to run across a hop: the target's recommendation, else the one you are on,
  // else the newest of the same family (stay on MariaDB rather than hop to Percona).
  function carry(x: HTMLTableRowElement, y: HTMLTableRowElement, dim: string, current?: string) {
    const both = shared(x, y, dim).map(({ th }) => th.dataset.label!);
    const target = recommended(y, dim);
    const here = current ?? recommended(x, dim);
    if (target && both.includes(target)) return target;
    if (here && both.includes(here)) return here;
    return both.filter((l) => family(l) === family(here)).at(-1) ?? both.at(-1)!;
  }

  // Hop forward to the newest release whose kept services still overlap with where you are,
  // stopping only at the newest patch of each line on the way.
  function route(a: HTMLTableRowElement, b: HTMLTableRowElement, keep: string[]) {
    const path = [a];
    let at = a;
    while (at !== b) {
      const ahead = rows.slice(rows.indexOf(b), rows.indexOf(at)).filter((r) => r === b || r.dataset.latest);
      const next = ahead.find((r) => keep.every((dim) => shared(at, r, dim).length > 0));
      if (!next) return undefined;
      path.push(next);
      at = next;
    }
    return path;
  }

  function li(html: string, muted = false) {
    const el = document.createElement('li');
    el.innerHTML = html;
    if (muted) el.className = 'text-panel-muted';
    return el;
  }

  function update() {
    const showAll = toggle.getAttribute('aria-pressed') === 'true';
    const a = rowOf(from.value);
    const b = rowOf(to.value);
    const keep = sticky.filter((c) => c.checked).map((c) => c.value);
    const ready = a && b && rows.indexOf(b) < rows.indexOf(a);
    const path = ready ? route(a, b, keep) ?? route(a, b, []) : undefined;
    const direct = ready && path!.length === 2 && keep.length > 0 && !route(a, b, keep);

    const both = headers.map((_, i) => !!(a && b && passes(a, i) && passes(b, i)));
    for (const row of rows) {
      const tag = row.querySelector<HTMLElement>('[data-tag]')!;
      const mark = row === a ? 'FROM' : row === b ? 'TO' : path?.includes(row) ? 'VIA' : '';
      tag.textContent = mark;
      tag.hidden = !mark;
      row.hidden = !(showAll || row.dataset.latest || mark);
      row.classList.toggle('opacity-35', !!path && !mark);
      row.classList.toggle('bg-sunken', !!mark);
      row.classList.toggle('bg-surface', !mark);
      row.querySelectorAll<HTMLElement>('td[data-col]').forEach((td) => td.classList.toggle('bg-hold', both[Number(td.dataset.col)]));
    }
    headers.forEach((th, i) => {
      th.classList.toggle('bg-hold', both[i]);
      th.classList.toggle('text-ink', both[i]);
    });

    if (!a || !b) return steps.replaceChildren(li('Pick where you are and where you are going.', true));
    if (!ready) return steps.replaceChildren(li('Pick a newer release to go to.', true));

    const items: HTMLLIElement[] = [];
    if (direct) items.push(li(`No route keeps ${keep.map(dimLabel).join(' and ')} the same, so this is one jump.`, true));
    const dimsHere = [...new Set(headers.map((th) => th.dataset.dim!))];
    const running: Record<string, string | undefined> = {};
    for (let h = 1; h < path!.length; h++) {
      const [x, y] = [path![h - 1], path![h]];
      const carried = dimsHere.filter((dim) => keep.includes(dim) && shared(x, y, dim).length > 0);
      const moves = carried.map((dim) => (running[dim] = carry(x, y, dim, running[dim])));
      const change = dimsHere
        .filter((dim) => !carried.includes(dim))
        .map((dim) => (running[dim] = recommended(y, dim)))
        .filter(Boolean);
      const on = moves.length ? `On <strong>${x.dataset.version}</strong>, run ${moves.join(', ')}. ` : '';
      const swap = change.length ? ` Switch to ${change.join(', ')} as part of it.` : '';
      items.push(li(`${on}Upgrade to <strong>${y.dataset.version}</strong>.${swap}`));
    }
    const after = keep.map((dim) => recommended(b, dim)).filter((rec, i) => rec && rec !== running[keep[i]]);
    if (after.length) items.push(li(`Then move to the recommended ${after.join(', ')}.`, true));
    steps.replaceChildren(...items);
  }

  from.addEventListener('change', update);
  to.addEventListener('change', update);
  sticky.forEach((c) => c.addEventListener('change', update));
  toggle.addEventListener('click', () => {
    const on = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(on));
    toggle.textContent = on ? 'Show newest patch only' : 'Show every patch';
    update();
  });
  update();
</script>
