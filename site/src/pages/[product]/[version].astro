---
import Base from '../../layouts/Base.astro';
import LogDialog from '../../components/LogDialog.astro';
import RunTable from '../../components/RunTable.astro';
import { getProducts, getVersionsForProduct } from '@lib/matrix.js';
import { getResultsForVersion, getVersionSummary } from '@lib/results.js';
import { neededWorkarounds, workaroundUsage } from '@lib/workarounds.js';
import {
  formatDate,
  formatDuration,
  getCells,
  getDimensions,
  getLines,
  getRelease,
  patchLabel,
  PRODUCT_LABELS,
  STEPS,
  STEP_LABELS,
  type Cell,
} from '@lib/compat.js';

export function getStaticPaths() {
  return getProducts().flatMap((p) =>
    getVersionsForProduct(p.name).map((version) => ({ params: { product: p.name, version } })),
  );
}

const { product, version } = Astro.params;
const label = PRODUCT_LABELS[product] ?? product;
const release = getRelease(product, version);
const results = getResultsForVersion(product, version);
const summary = getVersionSummary(product, version);
const cells = getCells(product, version);
const dims = getDimensions();
const siblings = release ? getLines(product).find((l) => l.line === release.line)?.releases ?? [] : [];

const recommended = [...cells.values()].filter((c) => c.recommended);
const baseline = recommended[0]?.result;
const baselineStatus = recommended[0]?.status ?? 'untested';
const steps = baseline
  ? STEPS.filter((s) => baseline.steps?.[s]).map((s) => ({ name: STEP_LABELS[s], ...baseline.steps[s] }))
  : [];
const longest = Math.max(1, ...steps.map((s) => s.duration_s));
const total = steps.reduce((n, s) => n + s.duration_s, 0);

// Failures grouped by cause; the recommended stack counts once, under its own name.
const groups = new Map<string, { summary: string; category: string; step: string; cells: Cell[] }>();
for (const c of cells.values()) {
  if (c.status !== 'fail' || !c.failure) continue;
  if (c.recommended && c !== recommended[0]) continue;
  const g = groups.get(c.failure.code) ?? { summary: c.failure.summary, category: c.failure.category, step: STEP_LABELS[c.failure.step], cells: [] };
  g.cells.push(c);
  groups.set(c.failure.code, g);
}
const failures = [...groups.values()].sort((a, b) => b.cells.length - a.cells.length);
const failCount = failures.reduce((n, g) => n + g.cells.length, 0);
const tested = summary.passCount + summary.failCount;
const workarounds = workaroundUsage(results);
const KIND_LABELS: Record<string, string> = { patch: 'Core patch', module: 'Extra module', composer: 'Composer fix' };
const extraOf = (c: Cell) => (c.status === 'pass' ? neededWorkarounds(c.result?.workarounds) : []);

const chip = 'inline-flex items-center gap-1.5 min-h-10 px-3 rounded-lg font-mono text-sm no-underline';
const tone = {
  pass: 'bg-pass text-pass-ink',
  fail: 'bg-fail text-fail-ink border border-dashed border-fail-line',
  untested: 'border border-dotted border-line text-muted',
};
const glyph = { pass: '✓', fail: '✕', untested: '·' };
---

<Base title={`${label} ${version}`} description={`${label} ${version}: ${summary.passCount} of ${tested} tested setups install and pass, and why the rest fail.`}>
  <nav class="text-sm text-muted" aria-label="Breadcrumb">
    <a href={`/${product}`} class="text-muted">{label}</a>
    {release && <span> / {release.line} line</span>}
  </nav>

  <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
    <div class="flex flex-col gap-2">
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl tracking-tight">{label} {version}</h1>
      <p class="text-lg text-muted">
        <strong class="text-ink">{summary.passCount} of {tested} tested setups work.</strong>
        {summary.unknownCount > 0 && ` ${summary.unknownCount} not tested yet.`}
        {' '}Last run {formatDate(summary.lastTested)}.
      </p>
    </div>
    {siblings.length > 1 && (
      <nav class="flex flex-wrap gap-1.5" aria-label={`Other ${release!.line} releases`}>
        {siblings.map((s) => (
          <a
            href={`/${product}/${s.version}`}
            aria-current={s.version === version ? 'page' : undefined}
            class:list={['px-3 py-2 rounded-lg font-mono text-sm no-underline', s.version === version ? 'bg-ink text-ground' : 'border border-line text-ink hover:border-brand']}
          >{patchLabel(product, s.version)}</a>
        ))}
      </nav>
    )}
  </div>

  {!release ? (
    <p class="mt-10 rounded-xl border border-dashed border-line p-8 text-center text-muted">
      {version} has no recommended stack in matrix.yml yet, so it has not been tested.
    </p>
  ) : (
    <>
      <section class="mt-8 rounded-2xl bg-panel text-panel-ink p-6 sm:p-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px]" aria-labelledby="stack">
        <div class="flex flex-col gap-4">
          <h2 id="stack" class="flex items-center gap-3 font-display font-bold text-2xl">
            <span aria-hidden="true" class:list={['grid place-items-center w-8 h-8 rounded-full text-base', tone[baselineStatus]]}>{glyph[baselineStatus]}</span>
            {baselineStatus === 'pass'
              ? 'The recommended stack passed'
              : baselineStatus === 'fail'
                ? 'The recommended stack failed'
                : 'The recommended stack has not run yet'}
          </h2>
          <ul class="flex flex-wrap gap-2" aria-label="Recommended stack">
            {recommended.map((c) => (
              <li class="px-3 py-2 rounded-lg bg-black/25 font-mono text-sm">{c.option.label}</li>
            ))}
          </ul>
          {baselineStatus === 'fail' && recommended[0].failure && (
            <p class="font-mono text-sm text-panel-muted">
              {STEP_LABELS[recommended[0].failure.step]}: {recommended[0].failure.summary}
            </p>
          )}
          {baseline && (
            <button type="button" data-log-id={baseline.id} class="self-start h-11 px-4 rounded-lg border border-panel-muted font-semibold cursor-pointer hover:bg-black/20">
              View run log
            </button>
          )}
        </div>
        {steps.length > 0 && (
          <div class="flex flex-col gap-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-panel-muted">The run, {formatDuration(total)}</h3>
            {steps.map((s) => (
              <div class="grid grid-cols-[110px_minmax(0,1fr)_60px] items-center gap-3 text-sm">
                <span>{s.name}</span>
                <span class="h-2.5 rounded-full bg-black/25">
                  <span
                    class:list={['block h-2.5 rounded-full', s.status === 'pass' ? 'bg-[#7cd992]' : 'bg-[#ff8f7a]']}
                    style={`width: ${Math.max(3, (s.duration_s / longest) * 100)}%`}
                  ></span>
                </span>
                <span class="font-mono text-right text-panel-muted">{formatDuration(s.duration_s)}</span>
              </div>
            ))}
          </div>
        )}
      </section>

      {workarounds.length > 0 && (
        <section class="mt-8 rounded-2xl border border-line border-l-4 border-l-rec bg-surface p-6 sm:p-8" aria-labelledby="extra">
          <h2 id="extra" class="font-display font-bold text-2xl">Needs extra steps</h2>
          <p class="mt-1 text-muted">
            Some of these setups only work with a fix that is not in the release as shipped, so a plain{' '}
            <code class="font-mono text-sm">composer create-project</code> will not include it.
          </p>
          <ul class="mt-5 flex flex-col gap-5">
            {workarounds.map((w) => (
              <li class="flex flex-col gap-1.5">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-muted">{KIND_LABELS[w.kind] ?? w.kind}</span>
                  <h3 class="font-semibold">{w.title}</h3>
                  <span class="text-sm text-muted">{w.passed} of {w.used} setups using it pass</span>
                </div>
                {(w.php || w.environment) && (
                  <p class="text-sm font-medium">Only needed on {[w.php && `PHP ${w.php.join(', ')}`, w.environment].filter(Boolean).join(', ')}.</p>
                )}
                {w.detail && <p class="text-sm text-muted">{w.detail}</p>}
                {w.source && <a href={w.source} class="self-start text-sm" rel="noopener">Source</a>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_420px] items-start">
        <section aria-labelledby="swap">
          <h2 id="swap" class="font-display font-extrabold text-3xl tracking-tight">Swap one service at a time</h2>
          <p class="mt-2 text-muted">Each chip is the recommended stack with only that service changed. The chip with a dot is the recommendation.</p>
          <div class="mt-4">
            {dims.map((d) => (
              <div class="grid gap-3 sm:grid-cols-[120px_minmax(0,1fr)] py-4 border-t border-line">
                <h3 class="font-semibold pt-2">{d.label}</h3>
                <div class="flex flex-wrap gap-2">
                  {d.options.map((o) => {
                    const c = cells.get(o.id)!;
                    const verdict = c.status === 'pass' ? 'works' : c.status === 'fail' ? 'fails' : 'not tested';
                    const extra = extraOf(c).length > 0;
                    const needs = extra ? `, needs ${extraOf(c).map((w) => w.title).join('; ')}` : '';
                    return (
                      <a
                        href={o.href}
                        title={`${o.label}: ${verdict}${c.recommended ? ' (recommended)' : ''}${needs}`}
                        class:list={[chip, tone[c.status], c.recommended && 'relative after:absolute after:top-[3px] after:right-[3px] after:size-1 after:rounded-full after:bg-current']}
                      >
                        <span aria-hidden="true">{glyph[c.status]}{extra && '+'}</span>
                        {o.label}
                        <span class="sr-only">: {verdict}{c.recommended && ', recommended'}{needs}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </section>

        <aside aria-labelledby="why" class="flex flex-col gap-4">
          <h2 id="why" class="font-display font-extrabold text-3xl tracking-tight">
            {failCount === 0 ? 'No failures' : `Why ${failCount} setup${failCount === 1 ? '' : 's'} failed`}
          </h2>
          {failures.map((g) => (
            <div class="rounded-xl border border-line bg-surface p-5 flex flex-col gap-3">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-semibold leading-snug">{g.summary}</h3>
                <span class="text-sm text-muted whitespace-nowrap">{g.cells.length} setup{g.cells.length === 1 ? '' : 's'}</span>
              </div>
              {g.category === 'harness' && (
                <p class="text-sm rounded-md bg-sunken px-3 py-2">A problem with the test harness, not with this stack.</p>
              )}
              <p class="text-sm text-muted">Stopped at {g.step.toLowerCase()}.</p>
              <div class="flex flex-wrap gap-1.5">
                {g.cells.map((c) => (
                  <button type="button" data-log-id={c.result!.id} class="px-2.5 py-1.5 rounded-md border border-line font-mono text-xs text-ink cursor-pointer hover:border-brand" title={`View the log for ${c.recommended ? 'the recommended stack' : c.option.label}`}>
                    {c.recommended ? 'Recommended stack' : c.option.label}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </aside>
      </div>
    </>
  )}

  {results.length > 0 && (
    <section class="mt-14" aria-labelledby="runs">
      <h2 id="runs" class="font-display font-extrabold text-2xl tracking-tight mb-4">Every run ({results.length})</h2>
      <RunTable results={results} />
    </section>
  )}

  <LogDialog results={results} />
</Base>
