---
import Base from '../../layouts/Base.astro';
import LogDialog from '../../components/LogDialog.astro';
import RunTable from '../../components/RunTable.astro';
import { getProductNames } from '@lib/matrix.js';
import { getBaselineResult, getReleases, PRODUCT_LABELS } from '@lib/compat.js';
import type { TestResult } from '@lib/types.js';

export function getStaticPaths() {
  return getProductNames().map((product) => ({ params: { product } }));
}

const { product } = Astro.params;
const label = PRODUCT_LABELS[product] ?? product;
const rows = getReleases(product).map((r) => ({ version: r.version, result: getBaselineResult(product, r.version) }));
const results = rows.map((r) => r.result).filter((r): r is TestResult => !!r);
const passing = results.filter((r) => r.overall_status === 'pass').length;
const missing = rows.filter((r) => !r.result).map((r) => r.version);
---

<Base title={`${label} recommended stacks, tested`} description={`The stack ${label === 'Magento' ? 'Adobe' : 'Mage-OS'} lists in its system requirements for every ${label} release, installed and tested in Docker.`}>
  <nav class="text-sm" aria-label="Breadcrumb"><a href={`/${product}/`} class="text-muted">{label}</a></nav>
  <h1 class="mt-2 font-display font-extrabold text-4xl sm:text-5xl tracking-tight">{label} recommended stacks</h1>
  <p class="mt-3 text-lg text-muted max-w-3xl">
    One run per release on the stack from its system requirements. These should all pass; a failure here usually
    means a harness problem or a genuinely broken release.
  </p>
  <p class="mt-4 font-semibold">
    {passing} of {results.length} passed{missing.length > 0 && `, ${missing.length} not run yet`}.
  </p>

  <div class="mt-8">
    <RunTable results={results} lead={{ heading: 'Release', cell: (r) => ({ text: r.version, href: `/${product}/${r.version}/` }) }} />
  </div>

  {missing.length > 0 && (
    <p class="mt-6 text-muted">Not run yet: <span class="font-mono">{missing.join(', ')}</span></p>
  )}

  <LogDialog />
</Base>
