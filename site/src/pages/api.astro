---
import Base from '../layouts/Base.astro';

const endpoints = [
  { path: '/api/v1/matrix.json', example: '/api/v1/matrix.json', desc: 'The matrix definition from matrix.yml: every product, release, recommended stack and service version.' },
  { path: '/api/v1/results.json', example: '/api/v1/results.json', desc: 'Every test result for every product, release and setup.' },
  { path: '/api/v1/health.json', example: '/api/v1/health.json', desc: 'Build metadata: total results, last run time and pass or fail counts.' },
  { path: '/api/v1/[product]/versions.json', example: '/api/v1/magento/versions.json', desc: 'The tested releases for a product, magento or mageos.' },
  { path: '/api/v1/[product]/[version].json', example: '/api/v1/magento/2.4.8-p5.json', desc: 'Every result for one release, with per-step details.' },
  { path: '/api/v1/[product]/github-matrix.json', example: '/api/v1/magento/github-matrix.json', desc: 'A GitHub Actions matrix of the stacks that passed, across all releases.' },
  { path: '/api/v1/[product]/[version]/github-matrix.json', example: '/api/v1/magento/2.4.8-p5/github-matrix.json', desc: 'A GitHub Actions matrix of the stacks that passed for one release.' },
  { path: '/api/v1/software/[service]/[type]-[version].json', example: '/api/v1/software/php/php-8.4.json', desc: 'How one service version fares across every release.' },
];
---

<Base title="Magento compatibility JSON API" description="Static JSON endpoints for Magento and Mage-OS compatibility results, plus GitHub Actions matrices of passing stacks. No key, no rate limit.">
  <h1 class="font-display font-extrabold text-4xl sm:text-5xl tracking-tight">API</h1>
  <p class="mt-3 text-lg text-muted max-w-3xl">
    Every response is a static JSON file built with the site and served from a CDN. No authentication, no rate limit.
  </p>
  <p class="mt-4 max-w-3xl rounded-xl border border-dashed border-fail-line bg-fail text-fail-ink px-4 py-3 text-sm">
    The endpoints and response shapes are not stable yet and may change without notice.
  </p>

  <ul class="mt-10 flex flex-col gap-3">
    {endpoints.map((e) => (
      <li class="rounded-xl border border-line bg-surface p-5 flex flex-col gap-2">
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-2 py-0.5 rounded bg-brand text-on-brand text-xs font-bold">GET</span>
          <code class="font-mono text-sm break-all">{e.path}</code>
          <a href={e.example} class="ml-auto text-sm font-semibold">Example →</a>
        </div>
        <p class="text-sm text-muted">{e.desc}</p>
      </li>
    ))}
  </ul>
</Base>
