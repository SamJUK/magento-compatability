---
import Base from '../layouts/Base.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { getGlobalStats } from '@lib/results.js';
import { getProductNames } from '@lib/matrix.js';
import { formatDate, getDimensions, getLines, getReleases, PRODUCT_LABELS, STEP_LABELS } from '@lib/compat.js';

const GITHUB_URL = 'https://github.com/samjuk/magento-compatability';
const stats = getGlobalStats();
const dims = getDimensions();
const optionCount = dims.reduce((n, d) => n + d.options.length, 0);

const products = getProductNames().map((name) => {
  const releases = getReleases(name);
  return {
    name,
    label: PRODUCT_LABELS[name] ?? name,
    count: releases.length,
    oldest: releases.at(-1)?.version,
    newest: releases[0]?.version,
    lines: getLines(name).map((l) => ({ line: l.line, count: l.releases.length })),
  };
});

const how = [
  { step: STEP_LABELS.stack_up, text: 'PHP, database, search, cache, queue, web server and Varnish start in Docker Compose.' },
  { step: STEP_LABELS.install, text: 'composer create-project, then bin/magento setup:install against that stack.' },
  { step: STEP_LABELS.smoke, text: 'setup:upgrade and setup:di:compile run without errors.' },
  { step: STEP_LABELS.playwright, text: 'Playwright loads the storefront, places a guest order and saves a CMS block in the admin.' },
];
---

<Base title="Will it run?">
  <section class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_400px] items-start">
    <div class="flex flex-col gap-7 lg:sticky lg:top-6">
      <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-muted">
        {stats.total.toLocaleString('en-GB')} real installs in Docker · last run {formatDate(stats.lastRun)}
      </p>
      <h1 class="font-display font-extrabold text-4xl sm:text-6xl leading-[1.02] tracking-tight">
        Pick a release and a service.<br class="hidden sm:block" /> We tell you if it installs.
      </h1>
      <QuestionCard />
    </div>

    <aside class="rounded-2xl bg-sunken p-6 flex flex-col gap-5" aria-labelledby="by-service">
      <div>
        <h2 id="by-service" class="font-display font-bold text-2xl">Or start from your server</h2>
        <p class="mt-1 text-sm text-muted leading-relaxed">
          Pick what your host runs. We show the newest release that installs on it, and what the next one needs.
        </p>
      </div>
      {dims.map((d) => (
        <div class="flex flex-col gap-2 pt-4 border-t border-line">
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted">{d.label}</h3>
          <div class="flex flex-wrap gap-1.5">
            {d.options.map((o) => (
              <a href={o.href} class="inline-flex items-center min-h-9 px-2.5 rounded-md border border-line bg-surface font-mono text-xs text-ink no-underline hover:border-brand">
                {o.label}
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="text-xs text-muted">{optionCount} service versions across {dims.length} kinds of service.</p>
    </aside>
  </section>

  <section class="mt-20 flex flex-col gap-6" aria-labelledby="products">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="products" class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight">Magento and Mage-OS, every patch</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {products.map((p) => (
        <div class="rounded-2xl border border-line bg-surface p-6 flex flex-col gap-4">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display font-bold text-2xl"><a href={`/${p.name}`} class="text-ink no-underline hover:text-brand">{p.label}</a></h3>
            <span class="text-sm text-muted"><strong class="text-xl text-ink">{p.count}</strong> releases</span>
          </div>
          <p class="text-muted leading-relaxed">
            Every release from {p.oldest} to {p.newest}, tested on the recommended stack and with each service swapped in turn.
          </p>
          <div class="flex flex-wrap gap-2">
            {p.lines.map((l) => (
              <a href={`/${p.name}#line-${l.line}`} class="px-2.5 py-1.5 rounded-md bg-sunken font-mono text-sm text-ink no-underline hover:text-brand">
                {l.line} <span class="text-muted">· {l.count}</span>
              </a>
            ))}
          </div>
          <a href={`/${p.name}`} class="mt-auto font-semibold text-brand py-1">Open the {p.label} matrix →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-20 flex flex-col gap-6" aria-labelledby="data">
    <h2 id="data" class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight">Take the data with you</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/api" class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">JSON API</span>
        <span class="text-sm text-panel-muted leading-relaxed">Static files on a CDN. No key, no rate limit.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">GET /api/v1/magento/2.4.8-p5.json</code>
      </a>
      <a href="/api" class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">GitHub Actions matrix</span>
        <span class="text-sm text-panel-muted leading-relaxed">Test your module against every stack that passed.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">GET /api/v1/magento/github-matrix.json</code>
      </a>
      <a href={GITHUB_URL} class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">Open source</span>
        <span class="text-sm text-panel-muted leading-relaxed">The harness, matrix.yml and every result file are on GitHub. Spot a wrong result? Open an issue.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">github.com/samjuk/magento-compatability</code>
      </a>
    </div>
  </section>

  <section class="mt-20 rounded-2xl border border-line bg-surface p-6 sm:p-10 grid gap-8 lg:grid-cols-[320px_minmax(0,1fr)]" aria-labelledby="how">
    <div class="flex flex-col gap-3">
      <h2 id="how" class="font-display font-extrabold text-3xl tracking-tight">How a setup is tested</h2>
      <p class="text-muted leading-relaxed">
        One run on the recommended stack from Adobe's or Mage-OS's system requirements. Then one run for every other
        service version, swapped in one at a time.
      </p>
    </div>
    <ol class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {how.map((h, i) => (
        <li class="flex flex-col gap-2 pt-4 border-t-4 border-brand">
          <span class="font-mono text-xs text-muted">0{i + 1}</span>
          <span class="font-bold text-lg">{h.step}</span>
          <span class="text-sm text-muted leading-relaxed">{h.text}</span>
        </li>
      ))}
    </ol>
  </section>
</Base>
