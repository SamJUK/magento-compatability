---
import Base from '../layouts/Base.astro';
import LogDialog from '../components/LogDialog.astro';
import StatusCell from '../components/StatusCell.astro';
import { getGlobalStats } from '@lib/results.js';
import { getProductNames } from '@lib/matrix.js';
import { formatDate, getCells, getDimensions, getReleases, PRODUCT_LABELS, STEP_LABELS } from '@lib/compat.js';
import { neededWorkarounds } from '@lib/workarounds.js';

const GITHUB_URL = 'https://github.com/samjuk/magento-compatability';
const stats = getGlobalStats();
const dims = getDimensions();
const columns = dims.flatMap((d) => d.options.map((o) => ({ ...o, dimLabel: d.label })));
// Rarely the deciding factor, so their columns start hidden behind the toggle above the grid.
const COLLAPSED = new Set(['cache', 'queue', 'webserver', 'varnish']);

// Newest release of each line: 2.4.8-p5 for Magento's 2.4.8. Mage-OS follows semver, so its
// service support only moves between majors and one row per major (3.5.0 for 3.x) is enough.
const lineOf = (product: string, version: string) =>
  product === 'magento' ? version.split('-p')[0] : `${version.split('.')[0]}.x`;

const products = getProductNames().map((product) => {
  const seen = new Set<string>();
  const latest = getReleases(product).filter((r) => {
    const line = lineOf(product, r.version);
    return !seen.has(line) && seen.add(line);
  });
  return {
    product,
    label: PRODUCT_LABELS[product] ?? product,
    rows: latest.map((r) => {
      const cells = getCells(product, r.version);
      const row = columns.map((col) => {
        const c = cells.get(col.id)!;
        const needed = c.status === 'pass' ? neededWorkarounds(c.result?.workarounds) : [];
        const verdict = c.status === 'pass' ? 'works' : c.status === 'fail' ? 'fails' : 'not tested';
        const why = c.failure ? ` (${STEP_LABELS[c.failure.step]}: ${c.failure.summary})` : '';
        const needs = needed.length ? `, needs ${needed.map((w) => w.title).join('; ')}` : '';
        return { ...c, extra: needed.length > 0, title: `${r.version} with ${col.label}: ${verdict}${needs}${why}` };
      });
      const tested = row.filter((c) => c.status !== 'untested');
      return { version: r.version, line: lineOf(product, r.version), cells: row, passed: tested.filter((c) => c.status === 'pass').length, tested: tested.length };
    }),
  };
});

const how = [
  { step: STEP_LABELS.stack_up, text: 'PHP, database, search, cache, queue, web server and Varnish start in Docker Compose.' },
  { step: STEP_LABELS.install, text: 'composer create-project, then bin/magento setup:install against that stack.' },
  { step: STEP_LABELS.smoke, text: 'setup:upgrade and setup:di:compile run without errors.' },
  { step: STEP_LABELS.playwright, text: 'Playwright loads the storefront, places a guest order and saves a CMS block in the admin.' },
];
---

<Base
  title="Magento & Mage-OS compatibility matrix"
  description="Which Magento 2 and Mage-OS versions work with which PHP, MySQL, MariaDB, OpenSearch, Elasticsearch, Redis, Valkey and RabbitMQ versions. Tested by real installs, not read from the docs."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'magento.works', url: Astro.site?.href, description: 'Magento and Mage-OS compatibility, tested by real installs in Docker.' }}
>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight">Magento and Mage-OS compatibility</h1>
      <p class="text-muted">
        The newest release of each line against every service version, from {stats.total.toLocaleString('en-GB')} real installs in Docker.
        Last run {formatDate(stats.lastRun)}.
      </p>
    </div>
    <a href="/check/" class="inline-flex items-center h-11 px-4 rounded-lg bg-brand text-on-brand font-semibold no-underline">Will it run on my stack? →</a>
  </section>

  <section class="mt-8 rounded-2xl border border-line bg-surface" aria-label="Newest release of each line against every service version">
    <label class="flex items-center justify-end gap-2 px-3 pt-3 text-sm text-muted cursor-pointer">
      <input type="checkbox" data-show-collapsed class="accent-brand" />
      Show cache, queue, web server and Varnish
    </label>
    <div class="relative overflow-x-auto">
      <table data-grid class="w-full border-separate border-spacing-0 text-xs">
        <thead>
          <tr>
            <th scope="col" rowspan="2" class="sticky left-0 z-10 bg-surface text-left px-3 pt-3 pb-1.5 font-display text-sm">Release</th>
            <th scope="col" rowspan="2" class="text-right px-1.5 pt-3 pb-1.5 font-mono text-[10px] font-medium text-muted align-bottom" title="Passing runs across every service, hidden columns included">pass</th>
            {dims.map((d) => (
              <th scope="colgroup" colspan={d.options.length} data-collapsed={COLLAPSED.has(d.key) || undefined} class="text-left px-1.5 pt-3 pb-0.5 font-display text-sm border-l border-line">{d.label}</th>
            ))}
          </tr>
          <tr>
            {columns.map((c, i) => (
              <th
                scope="col"
                data-collapsed={COLLAPSED.has(c.key) || undefined}
                class:list={['px-px pb-1.5 pt-0.5 font-mono text-[10px] font-medium text-muted whitespace-nowrap align-bottom', (i === 0 || columns[i - 1].key !== c.key) && 'border-l border-line']}
                title={c.label}
              >{c.short.split(' ').map((part) => <span class="block leading-tight">{part}</span>)}</th>
            ))}
          </tr>
        </thead>
        {products.map((p) => (
          <tbody>
            <tr>
              <th scope="colgroup" colspan={columns.length + 2} class="sticky left-0 bg-sunken text-left px-3 py-1.5 border-t border-line font-display text-sm">
                <a href={`/${p.product}/`} class="text-ink no-underline hover:text-brand">{p.label}</a>
              </th>
            </tr>
            {p.rows.map((r) => (
              <tr class="bg-surface">
                <th scope="row" class="sticky left-0 z-10 bg-inherit text-left px-3 py-0.5 border-t border-line whitespace-nowrap">
                  <a href={`/${p.product}/${r.version}/`} class="font-mono font-medium text-ink no-underline hover:text-brand">{r.version}</a>
                  {p.product !== 'magento' && <span class="ml-1 font-mono text-[10px] text-muted">{r.line}</span>}
                </th>
                <td class="px-1.5 py-0.5 border-t border-line text-right font-mono text-[10px] text-muted whitespace-nowrap">{r.passed}/{r.tested}</td>
                {r.cells.map((c, i) => (
                  <td data-collapsed={COLLAPSED.has(columns[i].key) || undefined} class:list={['p-px text-center border-t border-line', (i === 0 || columns[i - 1].key !== columns[i].key) && 'border-l']}>
                    <StatusCell status={c.status} recommended={c.recommended} extra={c.extra} href={`/${p.product}/${r.version}/`} logId={c.result?.id} title={c.title} class="min-w-6 h-6 px-0.5" />
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted">
    <span class="flex items-center gap-2"><StatusCell status="pass" title="Works" class="min-w-6 h-6" />Installs and passes</span>
    <span class="flex items-center gap-2"><StatusCell status="pass" extra title="Works with an extra step" class="min-w-6 h-6" />Works with an extra patch or module</span>
    <span class="flex items-center gap-2"><StatusCell status="fail" title="Fails" class="min-w-6 h-6" />Fails</span>
    <span class="flex items-center gap-2"><StatusCell status="untested" title="Not tested" class="min-w-6 h-6" />Not tested</span>
  </div>

  <section class="mt-20 flex flex-col gap-6" aria-labelledby="data">
    <h2 id="data" class="font-display font-extrabold text-3xl sm:text-4xl tracking-tight">Take the data with you</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/api/" class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">JSON API</span>
        <span class="text-sm text-panel-muted leading-relaxed">Static files on a CDN. No key, no rate limit.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">GET /api/v1/magento/2.4.8-p5.json</code>
      </a>
      <a href="/api/" class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">GitHub Actions matrix</span>
        <span class="text-sm text-panel-muted leading-relaxed">Test your module against every stack that passed.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">GET /api/v1/magento/github-matrix.json</code>
      </a>
      <a href={GITHUB_URL} class="rounded-2xl bg-panel text-panel-ink p-6 flex flex-col gap-3 no-underline">
        <span class="font-display font-bold text-xl">Open source</span>
        <span class="text-sm text-panel-muted leading-relaxed">The harness, matrix.yml and every result file are on GitHub. Spot a wrong result? Open an issue.</span>
        <code class="mt-auto font-mono text-xs rounded-md bg-black/25 px-3 py-2 break-all">github.com/samjuk/magento-compatability</code>
      </a>
    </div>
  </section>

  <section class="mt-20 rounded-2xl border border-line bg-surface p-6 sm:p-10 grid gap-8 lg:grid-cols-[320px_minmax(0,1fr)]" aria-labelledby="how">
    <div class="flex flex-col gap-3">
      <h2 id="how" class="font-display font-extrabold text-3xl tracking-tight">How a setup is tested</h2>
      <p class="text-muted leading-relaxed">
        One run on the recommended stack from Adobe's or Mage-OS's system requirements. Then one run for every other
        service version, swapped in one at a time.
      </p>
    </div>
    <ol class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {how.map((h, i) => (
        <li class="flex flex-col gap-2 pt-4 border-t-4 border-brand">
          <span class="font-mono text-xs text-muted">0{i + 1}</span>
          <span class="font-bold text-lg">{h.step}</span>
          <span class="text-sm text-muted leading-relaxed">{h.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <LogDialog />
</Base>

<style>
  section:has([data-show-collapsed]:not(:checked)) [data-collapsed] {
    display: none;
  }
</style>
