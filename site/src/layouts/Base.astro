---
import { Font } from 'astro:assets';
import Logo from '../components/Logo.astro';
import GridFocus from '../components/GridFocus.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** schema.org objects for a JSON-LD script in the head. */
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Pick a Magento or Mage-OS release and a service version. We tell you if it installs, from real Docker runs.',
  jsonLd,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// Lookout RUM page group: the route pattern, so "/[product]/[version]" -> "product-version".
const pageGroup = Astro.routePattern === '/' ? 'home' : Astro.routePattern.replace(/[[\]]/g, '').slice(1).replaceAll('/', '-');
const GITHUB_URL = 'https://github.com/samjuk/magento-compatability';

const nav = [
  { href: '/check/', label: 'Will it run?' },
  { href: '/magento/', label: 'Magento' },
  { href: '/mageos/', label: 'Mage-OS' },
  { href: '/software/', label: 'Services' },
  { href: '/api/', label: 'API' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} · magento.works</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="magento.works" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body class="min-h-screen flex flex-col bg-ground text-ink font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-surface px-3 py-2 rounded-md z-50">Skip to content</a>

    <header class="border-b border-line">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 min-h-16 py-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
          <Logo id="logo-header" size={30} />
          <span class="font-display font-extrabold text-lg tracking-tight">magento<span class="text-brand">.works</span></span>
        </a>

        <nav class="flex flex-wrap items-center gap-1 text-sm font-semibold" aria-label="Main">
          {nav.map(({ href, label }) => {
            const active = path.startsWith(href);
            return (
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'px-3 py-2.5 no-underline border-b-2',
                  active ? 'text-ink border-brand' : 'text-muted border-transparent hover:text-ink',
                ]}
              >{label}</a>
            );
          })}
          <a href={GITHUB_URL} class="px-3 py-2.5 text-muted hover:text-ink" aria-label="Source on GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <button id="theme-toggle" type="button" class="p-2.5 text-muted hover:text-ink cursor-pointer" aria-label="Switch between light and dark theme">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
            </svg>
          </button>
          <span class="ml-2 px-2.5 py-1 rounded-full bg-sunken text-muted text-xs font-semibold">Alpha</span>
          {import.meta.env.DEV && (
            <button id="dev-refresh-btn" type="button" title="Re-read matrix.yml and results (dev only)" class="ml-2 px-2.5 py-1 rounded-md text-xs font-semibold border border-line text-muted hover:text-ink cursor-pointer">
              Refresh data
            </button>
          )}
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row gap-3 justify-between text-sm text-muted">
        <div class="flex flex-col gap-1">
          <span>Not affiliated with Adobe or the Mage-OS Association. Alpha: data may be incomplete.</span>
          <span>
            Release dates: <a href="https://magento.watch/" class="text-muted">magento.watch</a> by
            <a href="https://github.com/lbajsarowicz" class="text-muted">Lukasz Bajsarowicz</a>, and
            <a href="https://github.com/mage-os/mageos-magento2/releases" class="text-muted">Mage-OS on GitHub</a>.
            Support dates: <a href="https://experienceleague.adobe.com/en/docs/commerce-operations/release/planning/lifecycle-policy" class="text-muted">Adobe</a>.
          </span>
        </div>
        <span class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/magento/supported-versions/" class="text-muted hover:text-ink">Magento support dates</a>
          <a href="/api/" class="text-muted hover:text-ink">API</a>
          <a href="/api/v1/results.json" class="text-muted hover:text-ink">results.json</a>
          <a href={GITHUB_URL} class="text-muted hover:text-ink">GitHub</a>
          <a href="mailto:hello@magento.works" class="text-muted hover:text-ink">hello@magento.works</a>
        </span>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      const refresh = document.getElementById('dev-refresh-btn') as HTMLButtonElement | null;
      refresh?.addEventListener('click', async () => {
        refresh.disabled = true;
        const res = await fetch('/_refresh', { method: 'POST' }).catch(() => null);
        if (res?.ok) location.reload();
        else {
          refresh.textContent = 'Refresh failed';
          refresh.disabled = false;
        }
      });
    </script>
    <GridFocus />
    <script is:inline set:html={`
window.RUM_CONFIG = {
    beacon_url: "https://lookout.sdj.pw/beacon/y0vl3towcebxro1owmlf3xvr",
    page_group: ${JSON.stringify(pageGroup)}
};
`}></script>
    <script is:inline>(function(){if(window.BOOMR&&(window.BOOMR.version||window.BOOMR.snippetExecuted)){return}window.BOOMR=window.BOOMR||{};window.BOOMR.snippetStart=(new Date).getTime();window.BOOMR.snippetExecuted=true;window.BOOMR.snippetVersion=16;window.BOOMR.url="https://lookout.sdj.pw/rum.js";var e=document.currentScript||document.getElementsByTagName("script")[0],a=e.parentNode,s=false,t=window.BOOMR_loader_timeout||3e3;function n(){if(s){return}var e=document.createElement("script");e.id="boomr-scr-as";e.src=window.BOOMR.url;e.async=true;a.appendChild(e);s=true}function o(e){s=true;var t,o=document,n,i,d,r=window;window.BOOMR.snippetMethod=e?"if":"i";n=function(e,t){var n=o.createElement("script");n.id=t||"boomr-if-as";n.src=window.BOOMR.url;BOOMR_lstart=(new Date).getTime();e=e||o.body;e.appendChild(n)};if(!window.addEventListener&&window.attachEvent&&navigator.userAgent.match(/MSIE [678]\./)){window.BOOMR.snippetMethod="s";n(a,"boomr-async");return}i=document.createElement("IFRAME");i.src="about:blank";i.title="";i.role="presentation";i.loading="eager";i.id="boomr-if";d=(i.frameElement||i).style;d.width=0;d.height=0;d.border=0;d.display="none";(o.body||a).appendChild(i);try{r=i.contentWindow;o=r.document.open()}catch(e){t=document.domain;i.src="javascript:var d=document.open();d.domain='"+t+"';void 0;";r=i.contentWindow;o=r.document.open()}r._boomrl=function(){n()};if(r.addEventListener){r.addEventListener("load",r._boomrl,false)}else if(r.attachEvent){r.attachEvent("onload",r._boomrl)}o.close()}var i=document.createElement("link");if(i.relList&&typeof i.relList.supports==="function"&&i.relList.supports("preload")&&"as"in i){window.BOOMR.snippetMethod="p";i.href=window.BOOMR.url;i.rel="preload";i.as="script";i.addEventListener("load",n);i.addEventListener("error",function(){o(true)});setTimeout(function(){if(!s){o(true)}},t);BOOMR_lstart=(new Date).getTime();a.appendChild(i)}else{o(false)}function d(e){window.BOOMR_onload=e&&e.timeStamp||(new Date).getT