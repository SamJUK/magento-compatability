---
import type { CellStatus } from '@lib/compat.js';

interface Props {
  status: CellStatus;
  /** Marks the recommended stack for page scripts; not shown in the grid. */
  recommended?: boolean;
  href?: string;
  /** Result id: a click opens that run in the page's LogDialog instead of following href. */
  logId?: string;
  /** Accessible description, e.g. "2.4.8-p5 with PHP 8.5: fails" */
  title: string;
  /** The run only passed with an extra patch, module or Composer fix. */
  extra?: boolean;
  /** Text inside the cell; defaults to a tick, cross or dot. */
  text?: string;
  class?: string;
}

const { status, recommended = false, extra = false, href, logId, title, text, class: className = '' } = Astro.props;

const glyph = text ?? (status === 'pass' ? (extra ? '✓+' : '✓') : status === 'fail' ? '✕' : '·');
const tone = {
  pass: 'bg-pass text-pass-ink',
  fail: 'bg-fail text-fail-ink border border-dashed border-fail-line',
  untested: 'border border-dotted border-line text-muted',
}[status];
const classes = `inline-grid place-items-center px-1.5 rounded-md font-mono text-xs font-semibold no-underline ${tone} ${className || 'min-w-10 h-9'}`;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class={classes} title={title} aria-label={title} data-status={status} data-rec={recommended ? '1' : undefined} data-log-id={logId}>
  <span aria-hidden="true">{glyph}</span>
</Tag>
