---
import type { CellStatus } from '@lib/compat.js';

interface Props {
  status: CellStatus;
  recommended?: boolean;
  href?: string;
  /** Accessible description, e.g. "2.4.8-p5 with PHP 8.5: fails" */
  title: string;
  /** Text inside the cell; defaults to a tick, cross or dot. */
  text?: string;
  class?: string;
}

const { status, recommended = false, href, title, text, class: className = '' } = Astro.props;

const glyph = text ?? (status === 'pass' ? '✓' : status === 'fail' ? '✕' : '·');
const tone = {
  pass: 'bg-pass text-pass-ink',
  fail: 'bg-fail text-fail-ink border border-dashed border-fail-line',
  untested: 'border border-dotted border-line text-muted',
}[status];
const ring = recommended ? 'outline-2 outline-offset-2 outline-rec' : '';
const classes = `inline-grid place-items-center px-1.5 rounded-md font-mono text-xs font-semibold no-underline ${tone} ${ring} ${className || 'min-w-10 h-9'}`;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class={classes} title={title} aria-label={title} data-status={status} data-rec={recommended ? '1' : undefined}>
  <span aria-hidden="true">{glyph}</span>
</Tag>
