---
import FailureBadge from './FailureBadge.astro';
import type { FailureOverview as FailureOverviewType } from '@lib/types.js';

interface Props {
  overview: FailureOverviewType;
  title?: string;
  description?: string;
}

const { overview, title = 'Failure breakdown', description } = Astro.props;

const categoryLabels: Record<string, string> = {
  compatibility: 'Compatibility issues',
  harness: 'Harness issues',
  infrastructure: 'Infrastructure issues',
  unknown: 'Unknown signatures',
};

const topBuckets = overview.buckets.slice(0, 8);
---

{overview.totalFailedRuns > 0 && (
  <section class="mb-8 rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50/70 dark:bg-zinc-900/40 p-5">
    <div class="flex flex-col gap-2 mb-5">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-white">{title}</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {description ?? 'Failed runs are bucketed by known signatures so maintainers can separate real compatibility problems from harness noise faster.'}
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4 mb-5">
      <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40 p-4">
        <div class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-1">Failed runs</div>
        <div class="text-2xl font-bold text-zinc-900 dark:text-white tabular-nums">{overview.totalFailedRuns}</div>
      </div>
      <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40 p-4">
        <div class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-1">Classified</div>
        <div class="text-2xl font-bold text-zinc-900 dark:text-white tabular-nums">{overview.classifiedRuns}</div>
      </div>
      <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40 p-4">
        <div class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-1">Likely flaky</div>
        <div class="text-2xl font-bold text-zinc-900 dark:text-white tabular-nums">{overview.likelyFlakyRuns}</div>
      </div>
      <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40 p-4">
        <div class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-1">Unclassified</div>
        <div class="text-2xl font-bold text-zinc-900 dark:text-white tabular-nums">{overview.unclassifiedRuns}</div>
      </div>
    </div>

    {overview.categoryCounts.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-5">
        {overview.categoryCounts.map((entry) => (
          <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40 px-3 py-1.5">
            <FailureBadge category={entry.category} size="sm" />
            <span class="text-xs text-zinc-600 dark:text-zinc-300">
              {(categoryLabels[entry.category] ?? entry.category)}: <strong class="tabular-nums">{entry.count}</strong>
            </span>
          </div>
        ))}
      </div>
    )}

    {topBuckets.length > 0 && (
      <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950/40">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900/60">
              <th class="px-4 py-3 text-left font-semibold text-zinc-500 dark:text-zinc-400">Bucket</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-500 dark:text-zinc-400">Summary</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-500 dark:text-zinc-400">Affected variants</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-500 dark:text-zinc-400">Step</th>
              <th class="px-4 py-3 text-right font-semibold text-zinc-500 dark:text-zinc-400">Runs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {topBuckets.map((bucket) => (
              <tr>
                <td class="px-4 py-3 align-top whitespace-nowrap">
                  <div class="flex flex-col items-start gap-1.5">
                    <FailureBadge category={bucket.category} likelyFlaky={bucket.likelyFlakyCount > 0} size="sm" />
                    <code class="text-[11px] text-zinc-500 dark:text-zinc-400">{bucket.code}</code>
                  </div>
                </td>
                <td class="px-4 py-3 align-top text-zinc-700 dark:text-zinc-300">{bucket.summary}</td>
                <td class="px-4 py-3 align-top">
                  <div class="flex flex-wrap gap-1.5 max-w-xl">
                    {bucket.variants.slice(0, 4).map((variant) => (
                      <button
                        type="button"
                        class="failure-variant-btn rounded-md bg-zinc-100 dark:bg-zinc-900 px-2 py-1 text-[11px] text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors"
                        data-result-id={variant.id}
                        title="Open logs for this combination"
                      >
                        {variant.label}
                      </button>
                    ))}
                    {bucket.variants.length > 4 && (
                      <span class="inline-flex items-center rounded-md border border-zinc-200 dark:border-zinc-700 px-2 py-1 text-[11px] text-zinc-500 dark:text-zinc-400">
                        +{bucket.variants.length - 4} more
                      </span>
                    )}
                  </div>
                </td>
                <td class="px-4 py-3 align-top text-zinc-500 dark:text-zinc-400 font-mono text-xs">
                  {bucket.stepNames.join(', ')}
                </td>
                <td class="px-4 py-3 align-top text-right text-zinc-900 dark:text-white font-semibold tabular-nums">
                  {bucket.count}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
)}

<script>
  document.querySelectorAll('.failure-variant-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const resultId = btn.getAttribute('data-result-id');
      if (!resultId) return;
      window.dispatchEvent(new CustomEvent('open-run-logs', {
        detail: { resultId },
      }));
    });
  });
</script>
